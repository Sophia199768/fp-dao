{
    "name": "fp-dao",
    "version": "0.0.1",
    "scripts": {
        "bp": "blueprint",
        "start": "blueprint run",
        "build": "blueprint build",
        "tact:sync": "tact --config tact.config.json -p FpDao && node -e \"require('fs').copyFileSync('build/FpDao/FpDao_FpDao.ts','wrappers/FpDao.ts')\"",
